{
  "name": "@ouyangzhigang/web-replayer",
  "version": "0.0.1",
  "description": "Framework-agnostic Web Component for @ouyangzhigang/web-recorder session replay with interaction heatmap and operation analytics",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./components/*": "./dist/components/*.js"
  },
  "types": "./dist/types/index.d.ts",
  "collection": "./dist/collection/collection-manifest.json",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "stencil build",
    "dev": "concurrently \"stencil build --watch\" \"cd playground && pnpm dev\"",
    "test": "stencil test --spec --e2e && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "clean": "rm -rf dist www .stencil",
    "release": "npm version patch && npm publish"
  },
  "devDependencies": {
    "@stencil/core": "^4.22.0",
    "@stencil/react-output-target": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.4",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "pako": "^2.1.0",
    "rrweb": "^2.0.0"
  },
  "keywords": [
    "replay",
    "rrweb",
    "heatmap",
    "analytics",
    "web-component",
    "stencil"
  ],
  "author": "zaneouyang@lexin.com",
  "license": "MIT"
}
